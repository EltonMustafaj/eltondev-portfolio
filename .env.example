# Contact API configuration
# Recipient email address for incoming contact messages
EMAIL_TO=you@example.com

# Resend API key used by /api/contact for direct email sending
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Verified sender in your Resend account/domain
RESEND_FROM="Portfolio Contact <no-reply@yourdomain.com>"

# Optional: Discord webhook fallback/notification
DISCORD_WEBHOOK_URL=
